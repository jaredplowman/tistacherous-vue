{
  "name": "tistacherous-vue",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project rules-test \"vitest run --config rules/vitest.config.ts\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "sass": "^1.108.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
